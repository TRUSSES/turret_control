{
    "name": "ROS 2 - Raspberry Pi Cross Compilation Dev",
    "privileged": true,
    "build": {
        "dockerfile": "Dockerfile",
        "args": {
            "USERNAME": "turret",
            "USER_UID": "1000",
            "USER_GID": "1000"
        }
    },
    "remoteUser": "turret",
    "workspaceFolder": "/home/turret",
    "workspaceMount": "source=${localWorkspaceFolder},target=/home/turret,type=bind",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-themes",
                "ms-vscode.cpptools-extension-pack",
                "twxs.cmake",
                "donjayamanne.python-extension-pack",
                "eamodio.gitlens",
                "ms-iot.vscode-ros",
                "oderwat.indent-rainbow",
                "nonanonno.vscode-ros2",
                "vscode-ext.sync-rsync"
            ]
        }
    },
    "containerEnv": {
        "DISPLAY": "unix:0",
        "ROS_LOCALHOST_ONLY": "1",
        "ROS_DOMAIN_ID": "42",
        "CC": "/usr/bin/aarch64-linux-gnu-gcc",
        "CXX": "/usr/bin/aarch64-linux-gnu-g++",
        "SYSROOT": "/usr/aarch64-linux-gnu"
    },
    "runArgs": [
        "--memory=16g",  
        "--cpus=8",
        "--platform=linux/arm64",
        "--net=host",
        "--pid=host",
        "--ipc=host",
        "-e",
        "DISPLAY=${env:DISPLAY}"
    ],
    "mounts": [
        "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind,consistency=cached",
        "source=/dev/dri,target=/dev/dri,type=bind,consistency=cached"
    ],
    "postCreateCommand": "sudo rosdep update && sudo rosdep install --from-paths src --ignore-src -y && echo 'source /opt/ros/humble/setup.bash' >> ~/.bashrc"
}